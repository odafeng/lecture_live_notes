# Local credentials and Python environment
.env
.env.*
!.env.example
.venv/

# Private classroom data and local runtime state.
# Recordings, transcripts and notes never enter version control. The path rules below
# also cover the case where OUTPUT_DIR points somewhere other than lectures/.
/lectures/
**/transcript.txt
**/live_notes.md
**/final_notes.md
**/finalize_input.json
**/session.json
*.wav
/.runtime/
/.remember/

# Generated macOS launcher (rebuild from scripts/)
/Lecture.app/

# Python and macOS generated files
__pycache__/
*.py[cod]
.DS_Store
